{
  "name": "macn-alpha",
  "version": "1.0.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "benchmark": "node tests/benchmark.mjs",
    "lab": "node lab/cli.js",
    "lab:real": "node lab/cli.js --mode real",
    "lab:scale": "node lab/cli.js --mode simulated",
    "lab:multi": "node lab/cli.js --mode multi",
    "lab:capacity": "node lab/cli.js --mode capacity",
    "lab:compare": "node lab/cli.js --mode compare"
  },
  "dependencies": {
    "express": "4.21.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "socket.io-client": "4.8.1"
  }
}
